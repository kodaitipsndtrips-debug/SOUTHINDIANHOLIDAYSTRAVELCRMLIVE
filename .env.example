# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Endpoint URL for the Supabase database.
VITE_SUPABASE_URL=""

# SUPABASE_ANON_KEY: Anonymous public key for Supabase interactions.
VITE_SUPABASE_ANON_KEY=""

# DATABASE_URL: PostgreSQL Connection String for Supabase DB via Prisma ORM
DATABASE_URL="postgresql://postgres:password@db.supabase.co:5432/postgres?schema=public"


# SUPABASE STORAGE (optional — if set, file uploads go to Supabase Storage instead of local disk)
# Get from: Supabase project → Project Settings → API → service_role key
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="crm-uploads"

# CORS — comma-separated list of allowed origins in production
# Example: ALLOWED_ORIGINS="https://crm.southindianholidays.co.in,https://api.southindianholidays.co.in"
ALLOWED_ORIGINS=""
